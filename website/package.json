{
  "name": "freshday-dairy-website",
  "version": "1.0.0",
  "private": true,
  "description": "FreshDay home delivery website built with Next.js, React and Tailwind CSS",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "build:static": "node scripts/build-static.mjs",
    "check": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.6"
  }
}
